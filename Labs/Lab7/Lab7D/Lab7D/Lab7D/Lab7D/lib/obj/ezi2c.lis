 0047           ;  FUNCTION NAME:BYTE EzI2C_GetActivity(void)
 0047           ;
 0047           ;  DESCRIPTION:
 0047           ;    Return a non-zero value if the I2C hardware has seen activity on the bus.
 0047           ;    The activity flag will be cleared if set when calling this function.
 0047           ;
 0047           ;-----------------------------------------------------------------------------
 0047           ;
 0047           ;  ARGUMENTS:  none
 0047           ;
 0047           ;  RETURNS: 
 0047           ;    BYTE  non-zero = Activity
 0047           ;          zero     = No Activity
 0047           ;
 0047           ;  SIDE EFFECTS;    
