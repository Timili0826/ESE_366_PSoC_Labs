 0068 41DEFE        and   reg[EzI2C_INT_REG], ~EzI2C_INT_MASK              ; disable specified interrupt enable bit
                   IF(EzI2C_USED_I2C_BLOCK)
                    or    F, FLAG_XIO_MASK
                   and  reg[EzI2C_CFG_REG],~EzI2C_CFG_Slave_EN
                    and   F, ~FLAG_XIO_MASK
