include "m8c.inc"


;--------------------------------------------------
; Constants for SquareWave API's.
;--------------------------------------------------

SquareWave_CONTROL_REG_START_BIT:          equ 0x01    ; Control register start bit
SquareWave_INT_REG:                        equ 0x0e1
SquareWave_INT_MASK:                       equ 0x02


;--------------------------------------------------
; Constants for SquareWave user defined values
;--------------------------------------------------

SquareWave_PERIOD:                         equ 0x7d0
SquareWave_PULSE_WIDTH:                    equ 0x3e8


;--------------------------------------------------
; Register Address Constants for SquareWave
;--------------------------------------------------

SquareWave_COUNTER_LSB_REG:            equ 0x20   ; DR0 Count register
SquareWave_COUNTER_MSB_REG:            equ 0x24
SquareWave_PERIOD_LSB_REG:             equ 0x21   ; DR1 Period register
SquareWave_PERIOD_MSB_REG:             equ 0x25
SquareWave_COMPARE_LSB_REG:            equ 0x22   ; DR2 Compare register
SquareWave_COMPARE_MSB_REG:            equ 0x26
SquareWave_CONTROL_LSB_REG:            equ 0x23   ; Control register
SquareWave_CONTROL_MSB_REG:            equ 0x27
SquareWave_FUNC_LSB_REG:               equ 0x20   ; Function register
SquareWave_FUNC_MSB_REG:               equ 0x24
SquareWave_INPUT_LSB_REG:              equ 0x21   ; Input register
SquareWave_INPUT_MSB_REG:              equ 0x25
SquareWave_OUTPUT_LSB_REG:             equ 0x22   ; Output register
SquareWave_OUTPUT_MSB_REG:             equ 0x26


;--------------------------------------------------
; SquareWave Macro 'Functions'
;--------------------------------------------------

   macro SquareWave_Start_M
   or    reg[SquareWave_CONTROL_LSB_REG],  SquareWave_CONTROL_REG_START_BIT
   endm

   macro SquareWave_Stop_M
   and   reg[SquareWave_CONTROL_LSB_REG], ~SquareWave_CONTROL_REG_START_BIT
   endm

   macro SquareWave_EnableInt_M
   M8C_EnableIntMask SquareWave_INT_REG, SquareWave_INT_MASK
   endm

   macro SquareWave_DisableInt_M
   M8C_DisableIntMask SquareWave_INT_REG, SquareWave_INT_MASK
   endm


; end of file SquareWave.inc

