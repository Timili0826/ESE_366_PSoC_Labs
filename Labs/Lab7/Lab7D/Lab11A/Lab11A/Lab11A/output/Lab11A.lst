                                        (0279)     and  A,EzI2C_ADDR_MASK                                           ; Mask off alt address bit and R/W bit
                                        (0280)     cmp  A,[EzI2C_bAddr]                                             ; Check for proper Address
                                        (0281)     jz   .CHK_ADDR_MODE 
                                        (0282)     SetEzI2C_SCR ( EzI2C_SCR_NAK )                                   ; NAK Address 
                                        (0283)     jmp  EzI2C_ISR_END                                               ; Not valid Address, leave
                                        (0284) 
                                        (0285) ELSE    ;; STATIC ADDRESS
                                        (0286)     mov  A,reg[EzI2C_DR_REG]                                         ; Get transmitted address
                                        (0287)     and  A,EzI2C_ADDR_MASK                                           ; Mask off alt address bit and R/W bit
                                        (0288)     cmp  A,EzI2C_SLAVE_ADDR                                          ; Check for proper Address
                                        (0289)     jz   .CHK_ADDR_MODE 
                                        (0290)     SetEzI2C_SCR ( EzI2C_SCR_NAK )                                   ; NAK Address 
                                        (0291)     jmp  EzI2C_ISR_END                                               ; Not valid Address, leave
                                        (0292) ENDIF
                                        (0293)  IF (EzI2C_CY8C22x45)
