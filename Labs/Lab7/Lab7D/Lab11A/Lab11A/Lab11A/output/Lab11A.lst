                                        (0010) ;-----------------------------------------------------------
                                        (0011) ; C variable declared in main.c:
                                        (0012) ;
                                        (0013) ; struct I2C_Regs
                                        (0014) ; {
                                        (0015) ;     unsigned int  wPhase;
                                        (0016) ;     unsigned int  wPhaseRate;
                                        (0017) ;     unsigned char bGainValue;
                                        (0018) ; } MyI2C_Regs;
