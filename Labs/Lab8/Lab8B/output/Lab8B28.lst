                                        (0002) ; VC3Handler.asm
                                        (0003) ; Lab 7D - Programmable Sine Wave Generator
                                        (0004) ;===========================================================
                                        (0005) 
                                        (0006) include "m8c.inc"
                                        (0007) include "memory.inc"
                                        (0008) include "PSoCAPI.inc"
                                        (0009) 
                                        (0010) ;-----------------------------------------------------------
                                        (0011) ; C variable declared in main.c:
                                        (0012) ;
                                        (0013) ; struct I2C_Regs
                                        (0014) ; {
                                        (0015) ;     unsigned int  wPhase;
                                        (0016) ;     unsigned int  wPhaseRate;
                                        (0017) ;     unsigned char bGainValue;
                                        (0018) ; } MyI2C_Regs;
                                        (0019) ;
                                        (0020) ; Memory layout:
                                        (0021) ; _MyI2C_Regs + 0 = wPhase HIGH byte
                                        (0022) ; _MyI2C_Regs + 1 = wPhase LOW byte
                                        (0023) ; _MyI2C_Regs + 2 = wPhaseRate HIGH byte
                                        (0024) ; _MyI2C_Regs + 3 = wPhaseRate LOW byte
                                        (0025) ; _MyI2C_Regs + 4 = bGainValue
                                        (0026) ;-----------------------------------------------------------
                                        (0027) 
                                        (0028) export _VC3Handler
                                        (0029) 
                                        (0030) 
                                        (0031) _VC3Handler:
                                        (0032) 
                                        (0033)     ;-------------------------------------------------------
                                        (0034)     ; Phase = Phase + PhaseRate
                                        (0035)     ;
                                        (0036)     ; Do LOW byte first so carry propagates to HIGH byte.
                                        (0037)     ;-------------------------------------------------------
                                        (0038) 
0608: 51 09    MOV   A,[MyI2C_Regs+1]   (0039)     mov A, [_MyI2C_Regs + 1]       ; wPhase low byte
060A: 02 0B    ADD   A,[MyI2C_Regs+3]   (0040)     add A, [_MyI2C_Regs + 3]       ; + wPhaseRate low byte
060C: 53 09    MOV   [MyI2C_Regs+1],A   (0041)     mov [_MyI2C_Regs + 1], A
                                        (0042) 
060E: 51 08    MOV   A,[MyI2C_Regs]     (0043)     mov A, [_MyI2C_Regs + 0]       ; wPhase high byte
0610: 0A 0A    ADC   A,[MyI2C_Regs+2]   (0044)     adc A, [_MyI2C_Regs + 2]       ; + rate high + carry
0612: 53 08    MOV   [MyI2C_Regs],A     (0045)     mov [_MyI2C_Regs + 0], A
                                        (0046) 
                                        (0047)     ;-------------------------------------------------------
                                        (0048)     ; High byte of phase is the table index.
                                        (0049)     ; A = 0...255
                                        (0050)     ;-------------------------------------------------------
                                        (0051) 
0614: 51 08    MOV   A,[MyI2C_Regs]     (0052)     mov A, [_MyI2C_Regs + 0]
                                        (0053) 
                                        (0054)     ; Read:
                                        (0055)     ;       A = SineTable[A]
                                        (0056)     ;
                                        (0057)     ; INDEX supports a 256-byte relative lookup table.
                                        (0058)     ;-------------------------------------------------------
                                        (0059) 
0616: F0 09    INDEX 0x0621             (0060)     index SineTable
0618: 43 65 01 OR    REG[0x65],0x1      
                                        (0061) 
                                        (0062)     ;-------------------------------------------------------
                                        (0063)     ; Write the DAC register.
                                        (0064)     ; Manual requires Stall/Unstall around SCDAC_cr0 write.
                                        (0065)     ;-------------------------------------------------------
                                        (0066) 
                                        (0067)     M8C_Stall
061B: 60 80    MOV   REG[0x80],A        (0068)     mov reg[SCDAC_cr0], A
061D: 41 65 FE AND   REG[0x65],0xFE     
                                        (0069)     M8C_Unstall
                                        (0070) 
0620: 7E       RETI                     (0071)     reti
                                        (0072) 
                                        (0073) 
                                        (0074) ;===========================================================
                                        (0075) ; 256-entry sine lookup table
                                        (0076) ;
                                        (0077) ; Generated from the Lab 7D equation:
                                        (0078) ;
                                        (0079) ; 31*SIN(2*PI()*n/256)
                                        (0080) ;
                                        (0081) ; DAC register value:
                                        (0082) ; 128 + IF(x<0,32,0) + ABS(ROUND(x,0))
                                        (0083) ;
                                        (0084) ; Matches your Lab 7D spreadsheet.
                                        (0085) ;===========================================================
                                        (0086) 
                                        (0087) .literal
                                        (0088) 
                                        (0089) SineTable:
                                        (0090) 
                                        (0091) db 128,129,130,130,131,132,133,133,134,135,136,136,137,138,138,139
                                        (0092) db 140,141,141,142,143,143,144,145,145,146,146,147,148,148,149,149
