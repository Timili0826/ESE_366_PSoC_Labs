                                        (0112)  InputAtten_SetPower:
                                        (0113) _InputAtten_SetPower:
                                        (0114) 
                                        (0115)    RAM_PROLOGUE RAM_USE_CLASS_2
05C9: 21 03    AND   A,0x3              (0116)    and  A, POWERMASK                                 ; mask A to protect unchanged bits
05CB: 4F       MOV   X,SP               (0117)    mov  X, SP                                        ; define temp store location
                                        (0118) ;
05CC: 08       PUSH  A                  (0119)    push A                                            ; put power value in temp store
05CD: 5D 73    MOV   A,REG[0x73]        (0120)    mov  A, reg[InputAtten_GAIN_CR2]                        ; read power value
05CF: 21 FC    AND   A,0xFC             (0121)    and  A, ~POWERMASK                                ; clear power bits in A
05D1: 2B 00    OR    A,[X+0]            (0122)    or   A, [X]                                       ; combine power value with balance of reg.
05D3: 60 73    MOV   REG[0x73],A        (0123)    mov  reg[InputAtten_GAIN_CR2], A                   ; move complete value back to register
05D5: 18       POP   A                  (0124)    pop  A
05D6: 70 3F    AND   F,0x3F             
05D8: 71 C0    OR    F,0xC0             
