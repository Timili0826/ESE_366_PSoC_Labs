                                        (0168) ;;****************************************************
                                        (0169) ;; I2C_ISR  main entry point from vector 60h
                                        (0170) ;;
                                        (0171) ;;****************************************************
                                        (0172) 
                                        (0173) IF I2CHW_POLLED_PROCESS
                                        (0174) 
                                        (0175) _I2CHW_ISR:
                                        (0176)     reti ; stub out the ISR if this is going to be a polled function
                                        (0177) 
                                        (0178)  
                                        (0179)  
                                        (0180)  I2CHW_Poll:
                                        (0181) _I2CHW_Poll:
                                        (0182) ;    cases are:
                                        (0183) ;    1. Stop state after a Master write to this slave
                                        (0184) ;    2. possible Stop condition COMBINED with a new transaction is not a problem since the Stop will only flag that the 
                                        (0185) ;       previous write has been completed. (so just call the I2CA_Process routine for this case and let the process routine take
                                        (0186) ;       care of it.
                                        (0187)     ;case 1
                                        (0188)     RAM_SETPAGE_CUR	( >I2CHW_Poll_Status )
                                        (0189) 
                                        (0190)     tst [I2CHW_Poll_Status], I2C_WRITE_STARTED
                                        (0191)     jz  NOT_I2C_Write
                                        (0192)     tst reg[ I2CHW_SCR], I2C_STOP_ST
                                        (0193)     jz  NOT_I2C_Write
                                        (0194)     ;make sure the pushes and pops 'line up' or die horribly
                                        (0195)     push A
                                        (0196)     push X
                                        (0197) IF SYSTEM_LARGE_MEMORY_MODEL
                                        (0198)     REG_PRESERVE IDX_PP
                                        (0199) ENDIF
                                        (0200)     jmp STOPTRAP
                                        (0201)     
                                        (0202) NOT_I2C_Write:    
                                        (0203)     tst reg[ I2CHW_SCR], I2C_BYTE_COMPL
                                        (0204)     jnz  I2CHW_Process   ;if no other critical eventa are in evidence, process an I2C byte if it's done
                                        (0205)     ret
                                        (0206) 
                                        (0207)  I2CHW_Process:
                                        (0208) _I2CHW_Process:  ;don't need to export user will call I2CA_POLL which will call the I2CA_Process routine if necessary
                                        (0209) 
                                        (0210) 
                                        (0211) 
                                        (0212) ELSE
                                        (0213) ;; STUB for polling function when it's un-defined
                                        (0214)  I2CHW_Poll:
                                        (0215) _I2CHW_Poll:
03AB: 7F       RET                      (0216)     ret
                                        (0217) 
                                        (0218) 
                                        (0219) ;;*****************************************************************************************
                                        (0220) ;;                 I2C_MASTER  main entry point from vector 60h
                                        (0221) ;;*****************************************************************************************
                                        (0222) 
                                        (0223) _I2CHW_ISR:
                                        (0224) ENDIF
03AC: 08       PUSH  A                  (0225)     push A
03AD: 10       PUSH  X                  (0226)     push X
03AE: 5D D3    MOV   A,REG[0xD3]        
03B0: 08       PUSH  A                  
                                        (0227) 
                                        (0228) IF SYSTEM_LARGE_MEMORY_MODEL
                                        (0229)     REG_PRESERVE IDX_PP
                                        (0230) ENDIF
                                        (0231) 
                                        (0232) Process_REENTRY:
                                        (0233) 
                                        (0234) ;******************************************************************************************
                                        (0235) ;Before doing anything else check for the presence of a STOP_ST in combination with the
                                        (0236) ;STOP Interrupt Enable (STOPIE).  If this is what happened set appropriate bits, 
                                        (0237) ;clear and reset the main I2CHW interrupt to assure that we haven't missed a BYTE_COMPLETE
                                        (0238) ;interrupt and exit the interrupt.  If a BYTE_COMPLETE interrupt is concurrent with the STOP 
                                        (0239) ;interrupt the next entry to this interrupt will be immediate and the STOPIE bit will now be 
                                        (0240) ;cleared.  This removes the possibility of trying to process two different events within one 
                                        (0241) ;interrupt.
                                        (0242) ;          
                                        (0243) ;******************************************************************************************
                                        (0244) ; Check the Stop Bit in SCR only if the Stop Interrupt is enabled.    
                                        (0245)     IF(I2CHW_USED_I2C_BLOCK)
                                        (0246)     M8C_SetBank1
                                        (0247)     tst reg[I2CHW_CFG],I2C_STOPIE
                                        (0248)     M8C_SetBank0
                                        (0249)     ELSE
03B1: 49 D6 10 TST   REG[0xD6],0x10     (0250)     tst reg[I2CHW_CFG],I2C_STOPIE
                                        (0251)     ENDIF
03B4: A0 06    JZ    0x03BB             (0252)     jz  ByteComplProcess
03B6: 49 D7 20 TST   REG[0xD7],0x20     (0253)     tst reg[I2CHW_SCR],I2C_STOP_ST                         ; Test if the Interrupt is due to Stop Condition
                                        (0254) ;conditions that must be met here are Slave-enabled, STOP int enabled (STOPIE), and STOP_ST (status bit set)
03B9: B0 E5    JNZ   0x049F             (0255)     jnz STOPTRAP                                       ; If yes process Stop Trap
                                        (0256) 
                                        (0257) ByteComplProcess:
                                        (0258) ;*********END TEST OF STOP STATUS**********************************************************       
                                        (0259) 
                                        (0260) ;       file stored in Slave directory of user module
                                        (0261) ;program flow would likely be to first determine what 'mode' the device is in.  I.e. is Master and Slave mode enabled?
                                        (0262) ; control of program flow must take more into account when all more modes are enabled.
                                        (0263) ;
                                        (0264) ;* Slave only
                                        (0265)     ;very first thing to test is the I2C_ADDRIN bit.  If set then we are getting an address after a START
03BB: 49 D7 08 TST   REG[0xD7],0x8      (0266)     tst reg[I2CHW_SCR], I2C_ADDRIN
03BE: B0 74    JNZ   0x0433             (0267)     jnz I2C_EvaluateADDRIN
                                        (0268) 
                                        (0269)     ; if slave didn't recieve an address, then this must be data for it to deal with
03C0: 49 D7 04 TST   REG[0xD7],0x4      (0270)     tst reg[I2CHW_SCR], I2C_TX  ;if set we are transmitting => this is at end of byte to eval the ACK
03C3: B0 B8    JNZ   0x047C             (0271)     jnz I2C_EvaluateACKIN
                                        (0272)     ; if slave NOT transmitting and NOT an address then data is being recieved
                                        (0273)     ; ack it and process it.
                                        (0274) 
                                        (0275)     ;UNLESS the stop bit turns out to have been set...
03C5: 49 D7 20 TST   REG[0xD7],0x20     (0276)     tst reg[I2CHW_SCR], I2C_STOP_ST
03C8: B0 D6    JNZ   0x049F             (0277)     jnz STOPTRAP
                                        (0278)     ; if slave NOT transmitting and NOT an address and Master is NOT terminating the then data is being recieved
                                        (0279)     ; ack it and process it.
                                        (0280) 
                                        (0281) ;;code snipped from old SW I2C below
                                        (0282) ;
                                        (0283) ; MASTER WRITE to SLAVE
                                        (0284) ;
                                        (0285) ;@PSoC_UserCode_BODY1@ (Do not change this line.)
                                        (0286) ;---------------------------------------------------
                                        (0287) ; Insert your custom code below this banner
                                        (0288) ;---------------------------------------------------
                                        (0289) ; By modifying the section from here down to the next comment block
                                        (0290) ; a user could process data for a custom I2C WRITE application
                                        (0291) ; NOTE: I2C handshakes (ACK/NAK may be effected by any introduced bugs)
                                        (0292) ;********************************************************
03CA: 47 00 04 TST   [0x0],0x4          (0293)    tst   [I2CHW_bStatus], fI2C_NAKnextWr
03CD: B0 14    JNZ   0x03E2             (0294)    jnz   WrStoreData
                                        (0295)    ;
                                        (0296)    ;process write data here
                                        (0297)    ;
03CF: 7A 02    DEC   [0x2]              (0298)    dec   [I2CHW_Write_Count]
03D1: C0 39    JC    0x040B             (0299)    jc    I2CHW_WriteOverflow                                         ; carry set if value became -1
                                        (0300)    ;jz    WrStoreData
03D3: 3C 02 00 CMP   [0x2],0x0          (0301)    cmp   [I2CHW_Write_Count], 00                                     ;set nak flag, dec count, and store data
