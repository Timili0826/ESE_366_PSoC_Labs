                                        (0631)  ELSE
                                        (0632)    IF (CPU_CLOCK_JUST ^ OSC_CR0_CPU_24MHz)	; Not 24 MHz, Do Nothing...
                                        (0633)    ELSE						; Otherwise, 24 MHz is selected... raise error
                                        (0634) 	ERROR_PSoC SEE COMMENTS			; Error - cannot use 24 MHz w/ 3.3V operation (Clock <= 12 MHz)
                                        (0635)    ENDIF
                                        (0636)  ENDIF
                                        (0637) ENDIF
                                        (0638)     ;  The writes to the VLT_CR register below include setting the POR to VLT_CR_POR_HIGH, 
