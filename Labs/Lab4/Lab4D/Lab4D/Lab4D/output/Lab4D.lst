                                        (1204) ;-----------------------------------------------------------------------------
                                        (1205) ;  FUNCTION NAME: LCD_InitVBG
                                        (1206) ;
                                        (1207) ;  DESCRIPTION:
                                        (1208) ;     Initialize the vertical bargraph characters.
                                        (1209) ;
                                        (1210) ;-----------------------------------------------------------------------------
                                        (1211) ;
                                        (1212) ;  ARGUMENTS:  none
                                        (1213) ;
                                        (1214) ;  RETURNS:  none
                                        (1215) ;
                                        (1216) ;  SIDE EFFECTS:
                                        (1217) ;    REGISTERS ARE VOLATILE: THE A AND X REGISTERS MAY BE MODIFIED!
                                        (1218) ;    Only one type of bargraph (horizontal or vertical) may be used
                                        (1219) ;    at a time since they each require their own set of characters.
                                        (1220) ;
                                        (1221) ;  SIDE EFFECTS:
                                        (1222) ;    The A and X registers may be modified by this or future implementations
                                        (1223) ;    of this function.  The same is true for all RAM page pointer registers in
                                        (1224) ;    the Large Memory Model.  When necessary, it is the calling function's
                                        (1225) ;    responsibility to preserve their values across calls to fastcall16 
                                        (1226) ;    functions.
                                        (1227) ;          
                                        (1228) ;    Currently only the page pointer registers listed below are modified: 
                                        (1229) ;          CUR_PP
                                        (1230) ;
                                        (1231) ; Stack offset constants
                                        (1232) VBGDATA_CTR:      equ    00h           ; Char data count stack offset
                                        (1233) VBG_BYTES:        equ    01h           ; Byte counter stack offset
                                        (1234) 
                                        (1235)  LCD_InitVBG:
                                        (1236) _LCD_InitVBG:
                                        (1237)     RAM_PROLOGUE RAM_USE_CLASS_2
06B4: 4F       MOV   X,SP               (1238)     mov   X,SP                         ; Get location of stack
06B5: 08       PUSH  A                  (1239)     push  A                            ; Create 2 locations
06B6: 08       PUSH  A                  (1240)     push  A
                                        (1241) 
06B7: 50 40    MOV   A,0x40             (1242)     mov   A,LCD_CG_RAM_OFFSET              ; Setup pointer
06B9: 9E 3F    CALL  _LCD_Control       (1243)     call  LCD_Control                  ; Position the CG pointer
06BB: 56 00 01 MOV   [X+0],0x1          (1244)     mov   [X+VBGDATA_CTR],01h          ; Reset data counter
                                        (1245) 
                                        (1246)  .VBG_Loop1:                            ; loop once for each 8 characters
06BE: 56 01 08 MOV   [X+1],0x8          (1247)     mov   [X+VBG_BYTES],08h            ; Load cycle pointer
                                        (1248)  .VBG_Loop2:                            ; Loop once for each line in character (8 times)
06C1: 52 00    MOV   A,[X+0]            (1249)     mov   A,[X+VBGDATA_CTR]
06C3: 3B 01    CMP   A,[X+1]            (1250)     cmp   A,[X+VBG_BYTES]
06C5: D0 05    JNC   0x06CB             (1251)     jnc   .VBG_SOLID
06C7: 50 00    MOV   A,0x0              (1252)     mov   A,00h                        ; Empty line
06C9: 80 03    JMP   0x06CD             (1253)     jmp   .VBG_Load                     ; Jump to load the bargraph
                                        (1254) .VBG_SOLID:
06CB: 50 FF    MOV   A,0xFF             (1255)     mov   A,FFh                        ; Load solid line
                                        (1256) .VBG_Load:
06CD: 9E 17    CALL  _LCD_Write_Data|_LCD_WriteData|LCD_WriteData(1257)     call  LCD_WriteData                ; character data
06CF: 7B 01    DEC   [X+1]              (1258)     dec   [X+VBG_BYTES]                ; Dec byte counter
06D1: BF EF    JNZ   0x06C1             (1259)     jnz   .VBG_Loop2                    ; End Loop 2
06D3: 77 00    INC   [X+0]              (1260)     inc   [X+VBGDATA_CTR]
06D5: 3D 00 09 CMP   [X+0],0x9          (1261)     cmp   [X+VBGDATA_CTR],09h
06D8: BF E5    JNZ   0x06BE             (1262)     jnz   .VBG_Loop1                    ; End Loop1
                                        (1263) 
06DA: 18       POP   A                  (1264)     pop  A
06DB: 18       POP   A                  (1265)     pop  A
06DC: 50 0C    MOV   A,0xC              (1266)     mov  A,LCD_DISP_ON                    ; Turn on display, don't really
06DE: 9E 1A    CALL  _LCD_Control       (1267)     call LCD_Control                   ; need this.
06E0: 70 3F    AND   F,0x3F             
06E2: 71 C0    OR    F,0xC0             
                                        (1268)     RAM_EPILOGUE RAM_USE_CLASS_2
06E4: 7F       RET                      (1269)     ret
                                        (1270) .ENDSECTION
