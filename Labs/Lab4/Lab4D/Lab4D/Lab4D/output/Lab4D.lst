0454: 5D 36    MOV   A,REG[0x36]        (0276)    mov   A, reg[TachTimer_COMPARE_MSB_REG]
0456: 5C       MOV   X,A                (0277)    mov   X, A
0457: 5D 32    MOV   A,REG[0x32]        (0278)    mov   A, reg[TachTimer_COMPARE_LSB_REG]
                                        (0279)    RAM_EPILOGUE RAM_USE_CLASS_1
