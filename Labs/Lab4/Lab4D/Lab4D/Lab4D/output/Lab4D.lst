                                        (0357) .SECTION
                                        (0358) ;-----------------------------------------------------------------------------
                                        (0359) ;  FUNCTION NAME: LCD_WriteData
                                        (0360) ;
                                        (0361) ;  DESCRIPTION:
                                        (0362) ;     Write a byte to the LCD's data register.
                                        (0363) ;
                                        (0364) ;-----------------------------------------------------------------------------
                                        (0365) ;
                                        (0366) ;  ARGUMENTS:
                                        (0367) ;    A contains byte to be written to LCD data register
                                        (0368) ;
                                        (0369) ;  RETURNS: none
                                        (0370) ;
                                        (0371) ;  SIDE EFFECTS:
                                        (0372) ;    The A and X registers may be modified by this or future implementations
                                        (0373) ;    of this function.  The same is true for all RAM page pointer registers in
                                        (0374) ;    the Large Memory Model.  When necessary, it is the calling function's
                                        (0375) ;    responsibility to preserve their values across calls to fastcall16 
                                        (0376) ;    functions.
                                        (0377) ;          
                                        (0378) ;    Currently only the page pointer registers listed below are modified: 
                                        (0379) ;          CUR_PP
                                        (0380) ;
                                        (0381)  LCD_WriteData:
                                        (0382) _LCD_WriteData:
                                        (0383)  LCD_Write_Data:   ; Do not use
                                        (0384) _LCD_Write_Data:   ; Do not use
                                        (0385)     RAM_PROLOGUE RAM_USE_CLASS_1
04E6: 90 65    CALL  0x054D             (0386)     call  LCD_Check_Ready              ; Make sure controller is ready
                                        (0387)                                        ; A is preserved in LCD_Check_Ready
04E8: 08       PUSH  A                  (0388)     push  A                            ; Save copy of character
04E9: 67       ASR   A                  (0389)     asr   A                            ; Shift high nibble to right
04EA: 67       ASR   A                  (0390)     asr   A
04EB: 67       ASR   A                  (0391)     asr   A
04EC: 67       ASR   A                  (0392)     asr   A
04ED: 21 0F    AND   A,0xF              (0393)     and   A,0Fh                        ; Mask off high nibble
04EF: 90 3B    CALL  0x052C             (0394)     call  LCD_WDATA_Nibble             ; Write Upper nibble
04F1: 18       POP   A                  (0395)     pop   A                            ; Retrieve copy of character
04F2: 21 0F    AND   A,0xF              (0396)     and   A,0Fh                        ; Mask off high nibble
04F4: 40       NOP                      (0397)     nop
04F5: 40       NOP                      (0398)     nop
04F6: 40       NOP                      (0399)     nop
04F7: 90 33    CALL  0x052C             (0400)     call  LCD_WDATA_Nibble   ; Write Lower nibble
                                        (0401)     RAM_EPILOGUE RAM_USE_CLASS_1
04F9: 7F       RET                      (0402)     ret
                                        (0403) .ENDSECTION
                                        (0404) 
                                        (0405) .SECTION
