                                        (0624)     ; this selection. If the selection is valid, the POR level is then set.
                                        (0625)     ; Invalid cases checked: 
                                        (0626)     ;   -At 3.3 volt operation, the cpu rate must be at or below 12 MHz
                                        (0627) 
                                        (0628) 
                                        (0629) IF (POWER_SETTING & POWER_SET_3V3)		; 3.3V Operation?
