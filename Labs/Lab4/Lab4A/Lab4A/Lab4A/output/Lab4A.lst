                                        (0180) ;-----------------------------------------------------------------------------
                                        (0181) ;  FUNCTION NAME: LCD_PrCString
                                        (0182) ;
                                        (0183) ;  DESCRIPTION:
                                        (0184) ;    Print constant (ROM) string to LCD
                                        (0185) ;-----------------------------------------------------------------------------
                                        (0186) ;
                                        (0187) ;  ARGUMENTS:
                                        (0188) ;     A:X  Pointer to String
                                        (0189) ;          A contains MSB of string address
                                        (0190) ;          X contains LSB of string address
                                        (0191) ;
                                        (0192) ;  RETURNS:  none
                                        (0193) ;
                                        (0194) ;  SIDE EFFECTS:
                                        (0195) ;    The A and X registers may be modified by this or future implementations
                                        (0196) ;    of this function.  The same is true for all RAM page pointer registers in
                                        (0197) ;    the Large Memory Model.  When necessary, it is the calling function's
                                        (0198) ;    responsibility to preserve their values across calls to fastcall16 
                                        (0199) ;    functions.
                                        (0200) ;          
                                        (0201) ;    Currently only the page pointer registers listed below are modified: 
                                        (0202) ;          CUR_PP
                                        (0203) ;
                                        (0204)  LCD_PrCString:
                                        (0205) _LCD_PrCString:
                                        (0206)     RAM_PROLOGUE RAM_USE_CLASS_1
                                        (0207)  .Loop_PrCString:
03C7: 08       PUSH  A                  (0208)     push  A                            ; Store ROM pointer
03C8: 10       PUSH  X                  (0209)     push  X
03C9: 28       ROMX                     (0210)     romx                               ; Get character from ROM
03CA: B0 04    JNZ   0x03CF             (0211)     jnz   .LCD_PrCString_WR            ; print character and advance pointer
03CC: 20       POP   X                  (0212)     pop   X                            ; Restore the stack
03CD: 18       POP   A                  (0213)     pop   A
                                        (0214)     RAM_EPILOGUE RAM_USE_CLASS_1
03CE: 7F       RET                      (0215)     ret                                ; Return
                                        (0216) 
                                        (0217) .LCD_PrCString_WR:
03CF: 90 44    CALL  LCD_Write_Data|_LCD_WriteData|LCD_WriteData|_LCD_Write_Data(0218)     call  LCD_WriteData                ; Write data to LCD
03D1: 20       POP   X                  (0219)     pop   X                            ; Get ROM pointer
03D2: 18       POP   A                  (0220)     pop   A
03D3: 75       INC   X                  (0221)     inc   X                            ; Inc LSB of pointer
03D4: DF F2    JNC   _LCD_PrCString     (0222)     jnc   .Loop_PrCString
03D6: 74       INC   A                  (0223)     inc   A                            ; Inc MSB of pointer if LSB overflow
03D7: 8F EF    JMP   _LCD_PrCString     (0224)     jmp   .Loop_PrCString
                                        (0225) 
                                        (0226) .ENDSECTION
