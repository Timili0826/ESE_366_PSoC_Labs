                                        (0134) LCD_Port:           equ    PRT0DR
                                        (0135) LCD_PortMode0:      equ    PRT0DM0
                                        (0136) LCD_PortMode1:      equ    PRT0DM1
                                        (0137) 
                                        (0138) LCD_E:              equ    10h
                                        (0139) LCD_RW:             equ    40h
