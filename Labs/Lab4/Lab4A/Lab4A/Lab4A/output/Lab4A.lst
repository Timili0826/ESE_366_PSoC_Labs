                                        (1236) _LCD_InitVBG:
                                        (1237)     RAM_PROLOGUE RAM_USE_CLASS_2
05E3: 4F       MOV   X,SP               (1238)     mov   X,SP                         ; Get location of stack
05E4: 08       PUSH  A                  (1239)     push  A                            ; Create 2 locations
05E5: 08       PUSH  A                  (1240)     push  A
                                        (1241) 
05E6: 50 40    MOV   A,0x40             (1242)     mov   A,LCD_CG_RAM_OFFSET              ; Setup pointer
05E8: 9E 3F    CALL  _LCD_Control       (1243)     call  LCD_Control                  ; Position the CG pointer
05EA: 56 00 01 MOV   [X+0],0x1          (1244)     mov   [X+VBGDATA_CTR],01h          ; Reset data counter
                                        (1245) 
                                        (1246)  .VBG_Loop1:                            ; loop once for each 8 characters
05ED: 56 01 08 MOV   [X+1],0x8          (1247)     mov   [X+VBG_BYTES],08h            ; Load cycle pointer
                                        (1248)  .VBG_Loop2:                            ; Loop once for each line in character (8 times)
05F0: 52 00    MOV   A,[X+0]            (1249)     mov   A,[X+VBGDATA_CTR]
05F2: 3B 01    CMP   A,[X+1]            (1250)     cmp   A,[X+VBG_BYTES]
05F4: D0 05    JNC   0x05FA             (1251)     jnc   .VBG_SOLID
05F6: 50 00    MOV   A,0x0              (1252)     mov   A,00h                        ; Empty line
05F8: 80 03    JMP   0x05FC             (1253)     jmp   .VBG_Load                     ; Jump to load the bargraph
                                        (1254) .VBG_SOLID:
05FA: 50 FF    MOV   A,0xFF             (1255)     mov   A,FFh                        ; Load solid line
                                        (1256) .VBG_Load:
05FC: 9E 17    CALL  LCD_Write_Data|_LCD_WriteData|LCD_WriteData|_LCD_Write_Data(1257)     call  LCD_WriteData                ; character data
05FE: 7B 01    DEC   [X+1]              (1258)     dec   [X+VBG_BYTES]                ; Dec byte counter
0600: BF EF    JNZ   0x05F0             (1259)     jnz   .VBG_Loop2                    ; End Loop 2
0602: 77 00    INC   [X+0]              (1260)     inc   [X+VBGDATA_CTR]
0604: 3D 00 09 CMP   [X+0],0x9          (1261)     cmp   [X+VBGDATA_CTR],09h
0607: BF E5    JNZ   0x05ED             (1262)     jnz   .VBG_Loop1                    ; End Loop1
                                        (1263) 
0609: 18       POP   A                  (1264)     pop  A
060A: 18       POP   A                  (1265)     pop  A
060B: 50 0C    MOV   A,0xC              (1266)     mov  A,LCD_DISP_ON                    ; Turn on display, don't really
060D: 9E 1A    CALL  _LCD_Control       (1267)     call LCD_Control                   ; need this.
060F: 70 3F    AND   F,0x3F             
0611: 71 C0    OR    F,0xC0             
                                        (1268)     RAM_EPILOGUE RAM_USE_CLASS_2
0613: 7F       RET                      (1269)     ret
