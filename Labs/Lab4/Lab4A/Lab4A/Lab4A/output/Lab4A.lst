                                        (1171) .VBG_LOOP:
05B4: 08       PUSH  A                  (1172)     push  A
05B5: FF 91    INDEX LCD_ROW_OFFSET     (1173)     index LCD_ROW_OFFSET  ; Get row offset
05B7: 03 FC    ADD   A,[X-4]            (1174)     add   A,[X+VBG_COL]                ; Add column offset to position
05B9: 9E 6E    CALL  _LCD_Control       (1175)     call  LCD_Control                  ; Position Cursor
05BB: 3D FA 00 CMP   [X-6],0x0          (1176)     cmp   [X+VBG_SEG_HEIGHT],00h       ; Check for zero segs
05BE: B0 05    JNZ   0x05C4             (1177)     jnz   .VBG_NZ_SEG
05C0: 50 20    MOV   A,0x20             (1178)     mov   A,' '                        ; Load space character
