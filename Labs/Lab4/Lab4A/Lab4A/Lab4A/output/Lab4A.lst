05CF: 80 06    JMP   0x05D6             (1187)     jmp   .VBG_WRITE_CHAR
                                        (1188) 
                                        (1189) .VBG_FULL_SEG:                          ; Bargaph
05D1: 17 FA 08 SUB   [X-6],0x8          (1190)     sub   [X+VBG_SEG_HEIGHT],08h       ; Subtract full segment
05D4: 50 07    MOV   A,0x7              (1191)     mov   A,07h                        ; Load full segment
                                        (1192) 
                                        (1193) .VBG_WRITE_CHAR:                        ; Write character to display
05D6: 9E 3D    CALL  LCD_Write_Data|_LCD_WriteData|LCD_WriteData|_LCD_Write_Data(1194)     call  LCD_WriteData                ; Write value
05D8: 18       POP   A                  (1195)     pop   A
