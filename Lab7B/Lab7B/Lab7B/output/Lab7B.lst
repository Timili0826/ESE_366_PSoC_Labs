                                        (0041) AREA psoc_config(rom, rel)
                                        (0042) 
                                        (0043) ;---------------------------------------------------------------------------
                                        (0044) ; LoadConfigInit - Establish the start-up configuration (except for a few
                                        (0045) ;                  parameters handled by boot code, like CPU speed). This
                                        (0046) ;                  function can be called from user code, but typically it
                                        (0047) ;                  is only called from boot.
                                        (0048) ;
                                        (0049) ;       INPUTS: None.
                                        (0050) ;      RETURNS: Nothing.
                                        (0051) ; SIDE EFFECTS: Registers are volatile: the A and X registers can be modified!
                                        (0052) ;               In the large memory model currently only the page
                                        (0053) ;               pointer registers listed below are modified.  This does
                                        (0054) ;               not guarantee that in future implementations of this
                                        (0055) ;               function other page pointer registers will not be
                                        (0056) ;               modified.
                                        (0057) ;          
                                        (0058) ;               Page Pointer Registers Modified: 
                                        (0059) ;               CUR_PP
                                        (0060) ;
                                        (0061) _LoadConfigInit:
                                        (0062)  LoadConfigInit:
                                        (0063)     RAM_PROLOGUE RAM_USE_CLASS_4
                                        (0064)     
04F4: 55 00 00 MOV   [0x0],0x0          (0065) 	mov		[Port_2_Data_SHADE], 0h
04F7: 55 01 7F MOV   [0x1],0x7F         (0066) 	mov		[Port_2_DriveMode_0_SHADE], 7fh
04FA: 55 02 80 MOV   [0x2],0x80         (0067) 	mov		[Port_2_DriveMode_1_SHADE], 80h
                                        (0068) 
04FD: 7C 05 04 LCALL 0x0504             (0069) 	lcall	LoadConfig_lab7b
0500: 7C 04 2F LCALL 0x042F             (0070) 	lcall	LoadConfigTBL_lab7b_Ordered
                                        (0071) 
                                        (0072) 
                                        (0073)     RAM_EPILOGUE RAM_USE_CLASS_4
0503: 7F       RET                      (0074)     ret
                                        (0075) 
                                        (0076) ;---------------------------------------------------------------------------
                                        (0077) ; Load Configuration lab7b
                                        (0078) ;
                                        (0079) ;    Load configuration registers for lab7b.
                                        (0080) ;    IO Bank 0 registers a loaded first,then those in IO Bank 1.
                                        (0081) ;
                                        (0082) ;       INPUTS: None.
                                        (0083) ;      RETURNS: Nothing.
                                        (0084) ; SIDE EFFECTS: Registers are volatile: the CPU A and X registers may be
                                        (0085) ;               modified as may the Page Pointer registers!
                                        (0086) ;               In the large memory model currently only the page
                                        (0087) ;               pointer registers listed below are modified.  This does
                                        (0088) ;               not guarantee that in future implementations of this
                                        (0089) ;               function other page pointer registers will not be
                                        (0090) ;               modified.
                                        (0091) ;          
                                        (0092) ;               Page Pointer Registers Modified: 
                                        (0093) ;               CUR_PP
                                        (0094) ;
                                        (0095) _LoadConfig_lab7b:
                                        (0096)  LoadConfig_lab7b:
                                        (0097)     RAM_PROLOGUE RAM_USE_CLASS_4
                                        (0098) 
0504: 10       PUSH  X                  (0099) 	push	x
0505: 70 EF    AND   F,0xEF             
                                        (0100)     M8C_SetBank0                    ; Force bank 0
0507: 50 00    MOV   A,0x0              (0101)     mov     a, 0                    ; Specify bank 0
0509: 67       ASR   A                  (0102)     asr     a                       ; Store in carry flag
                                        (0103)                                     ; Load bank 0 table:
050A: 50 01    MOV   A,0x1              (0104)     mov     A, >LoadConfigTBL_lab7b_Bank0
050C: 57 BC    MOV   X,0xBC             (0105)     mov     X, <LoadConfigTBL_lab7b_Bank0
050E: 7C 05 1F LCALL 0x051F             (0106)     lcall   LoadConfig              ; Load the bank 0 values
                                        (0107) 
0511: 50 01    MOV   A,0x1              (0108)     mov     a, 1                    ; Specify bank 1
0513: 67       ASR   A                  (0109)     asr     a                       ; Store in carry flag
                                        (0110)                                     ; Load bank 1 table:
0514: 50 02    MOV   A,0x2              (0111)     mov     A, >LoadConfigTBL_lab7b_Bank1
0516: 57 27    MOV   X,0x27             (0112)     mov     X, <LoadConfigTBL_lab7b_Bank1
0518: 7C 05 1F LCALL 0x051F             (0113)     lcall   LoadConfig              ; Load the bank 1 values
051B: 70 EF    AND   F,0xEF             
                                        (0114) 
                                        (0115)     M8C_SetBank0                    ; Force return to bank 0
051D: 20       POP   X                  (0116) 	pop		x
                                        (0117) 
                                        (0118)     RAM_EPILOGUE RAM_USE_CLASS_4
051E: 7F       RET                      (0119)     ret
                                        (0120) 
                                        (0121) 
                                        (0122) 
                                        (0123) 
                                        (0124) ;---------------------------------------------------------------------------
                                        (0125) ; LoadConfig - Set IO registers as specified in ROM table of (address,value)
                                        (0126) ;              pairs. Terminate on address=0xFF.
                                        (0127) ;
                                        (0128) ;  INPUTS:  [A,X] points to the table to be loaded
                                        (0129) ;           Flag Register Carry bit encodes the Register Bank
                                        (0130) ;           (Carry=0 => Bank 0; Carry=1 => Bank 1)
                                        (0131) ;
                                        (0132) ;  RETURNS: nothing.
                                        (0133) ;
                                        (0134) ;  STACK FRAME:  X-4 I/O Bank 0/1 indicator
                                        (0135) ;                X-3 Temporary store for register address
                                        (0136) ;                X-2 LSB of config table address
                                        (0137) ;                X-1 MSB of config table address
                                        (0138) ;
                                        (0139) LoadConfig:
                                        (0140)     RAM_PROLOGUE RAM_USE_CLASS_2
051F: 38 02    ADD   SP,0x2             (0141)     add     SP, 2                   ; Set up local vars
0521: 10       PUSH  X                  (0142)     push    X                       ; Save config table address on stack
0522: 08       PUSH  A                  (0143)     push    A
0523: 4F       MOV   X,SP               (0144)     mov     X, SP
0524: 56 FC 00 MOV   [X-4],0x0          (0145)     mov     [X-4], 0                ; Set default Destination to Bank 0
0527: D0 04    JNC   0x052C             (0146)     jnc     .BankSelectSaved        ; Carry says Bank 0 is OK
0529: 56 FC 01 MOV   [X-4],0x1          (0147)     mov     [X-4], 1                ; No Carry: default to Bank 1
                                        (0148) .BankSelectSaved:
052C: 18       POP   A                  (0149)     pop     A
052D: 20       POP   X                  (0150)     pop     X
052E: 70 EF    AND   F,0xEF             
0530: 62 E3 00 MOV   REG[0xE3],0x0      
                                        (0151) 
                                        (0152) LoadConfigLp:
                                        (0153)     M8C_SetBank0                    ; Switch to bank 0
                                        (0154)     M8C_ClearWDT                    ; Clear the watchdog for long inits
0533: 10       PUSH  X                  (0155)     push    X                       ; Preserve the config table address
0534: 08       PUSH  A                  (0156)     push    A
0535: 28       ROMX                     (0157)     romx                            ; Load register address from table
0536: 39 FF    CMP   A,0xFF             (0158)     cmp     A, END_CONFIG_TABLE     ; End of table?
0538: A0 1F    JZ    0x0558             (0159)     jz      EndLoadConfig           ;   Yes, go wrap it up
053A: 4F       MOV   X,SP               (0160)     mov     X, SP                   ;
053B: 48 FC 01 TST   [X-4],0x1          (0161)     tst     [X-4], 1                ; Loading IO Bank 1?
053E: A0 03    JZ    0x0542             (0162)     jz      .IOBankNowSet           ;    No, Bank 0 is fine
0540: 71 10    OR    F,0x10             
                                        (0163)     M8C_SetBank1                    ;   Yes, switch to Bank 1
                                        (0164) .IOBankNowSet:
0542: 54 FD    MOV   [X-3],A            (0165)     mov     [X-3], A                ; Stash the register address
0544: 18       POP   A                  (0166)     pop     A                       ; Retrieve the table address
0545: 20       POP   X                  (0167)     pop     X
0546: 75       INC   X                  (0168)     inc     X                       ; Advance to the data byte
0547: 09 00    ADC   A,0x0              (0169)     adc     A, 0
0549: 10       PUSH  X                  (0170)     push    X                       ; Save the config table address again
054A: 08       PUSH  A                  (0171)     push    A
054B: 28       ROMX                     (0172)     romx                            ; load config data from the table
054C: 4F       MOV   X,SP               (0173)     mov     X, SP                   ; retrieve the register address
054D: 59 FD    MOV   X,[X-3]            (0174)     mov     X, [X-3]
054F: 61 00    MOV   REG[X+0x0],A       (0175)     mov     reg[X], A               ; Configure the register
0551: 18       POP   A                  (0176)     pop     A                       ; retrieve the table address
0552: 20       POP   X                  (0177)     pop     X
0553: 75       INC   X                  (0178)     inc     X                       ; advance to next table entry
0554: 09 00    ADC   A,0x0              (0179)     adc     A, 0
0556: 8F D7    JMP   0x052E             (0180)     jmp     LoadConfigLp            ; loop to configure another register
                                        (0181) EndLoadConfig:
0558: 38 FC    ADD   SP,0xFC            (0182)     add     SP, -4
055A: 70 3F    AND   F,0x3F             
055C: 71 C0    OR    F,0xC0             
                                        (0183)     RAM_EPILOGUE RAM_USE_CLASS_2
055E: 7F       RET                      (0184)     ret
                                        (0185) 
